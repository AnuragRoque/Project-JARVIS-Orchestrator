# ------------------------------------------------------------------------------
vosk-model-*/
models/
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.gguf

# ------------------------------------------------------------------------------
# Build, Distribution & Packaging (PyInstaller, setuptools, wheels)
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ------------------------------------------------------------------------------
# Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# ------------------------------------------------------------------------------
# IDEs, Code Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
